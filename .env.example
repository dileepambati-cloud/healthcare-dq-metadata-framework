# Copy to .env and fill in. Only needed for datasets with source_type = 'table'.
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DQ_DEMO
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=SYSADMIN

# Only needed for datasets with source_type = 'oracle'
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/XEPDB1

# Email alerts (optional). Leave SMTP_HOST empty to skip sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=dq-alerts@example.com
ALERT_TO=data-team@example.com
